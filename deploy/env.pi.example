# Copy to the Pi as e.g. ~/funds/.env and reference from systemd (EnvironmentFile).
# DATABASE_URL must reach Postgres (host port 5434 if using bundled compose mapping).

DATABASE_URL=postgres://funds:funds@127.0.0.1:5434/funds?sslmode=disable
SERVER_PORT=2020

# Browser origins that call the API (comma-separated). Include your Pi URL, e.g.:
# CORS_ORIGINS=http://media.lan,http://192.168.1.50,https://media.lan
CORS_ORIGINS=
