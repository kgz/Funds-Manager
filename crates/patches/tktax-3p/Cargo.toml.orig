[package]
name = "tktax-3p"
version = "0.2.2"
edition = "2024"
description = "Third party deps for the tktax financial suite"
license = "MIT"
readme = "README.md"
authors = [ "klebs tpk3.mx@gmail.com" ]
repository = "https://github.com/klebs6/tktax"

[dependencies]
rust_decimal = { version = "1.36.0", features = ["maths"] }
num-format = { version = "0.4.4", features = ["with-serde"] }
csv = "1.3.1"
error-tree = "0.6.0"
derive_builder = "0.20.2"
getset = "0.1.3"
approx = "0.4.0"
itertools = "0.10.5"
approx_eq = "0.1.8"
bitflags = "1.3.2"
delegate = "0.10.0"
encoding_rs = "0.8.35"
encoding_rs_io = "0.1.7"
chrono = { version = "0.4.39", features = ["serde"] }
serde  = { version = "1.0.217", features = ["derive"] }
serde_json = "1.0.135"
regex = "1.11.1"
rust-stemmers = "1.2.0"
unicode-segmentation = "1.12.0"
linfa = "0.7.1"
indoc = "2.0.5"
linfa-bayes = "0.7.1"
linfa-preprocessing = "0.7.0"
ndarray = "0.15.6"
rustlearn = "0.5.0"
rand = "0.3.23"
strsim = "0.11.1"
ndarray-stats = "0.5.1"
lazy_static = "1.5.0"
enhanced_enum = "0.2.2"
num-traits = "0.2.19"
tracing = "0.1.41"
tracing-subscriber = { version = "0.3.19", features = ["env-filter"] }
config = "0.15.6"
derive-error = "0.0.5"
export-magic = "0.3.6"
disable_macro = "0.3.6"
traced-test = "1.0.2"
tracing-setup = "1.0.2"

[build-dependencies]
scan-crate-for-typedefs = "0.8.1"
