    "@tanstack/react-virtual": "^3.14.12",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.1",
    "@use-gesture/react": "^10.3.1",
    "autoprefixer": "^10.5.6",
    "axios": "^1.20.0",
    "fs": "0.0.1-security",
    "lucide-react": "^1.45.0",
    "luxon": "^3.7.2",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.42.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "redux-saga": "^1.5.1",
    "tailwindcss": "^4.3.3",
