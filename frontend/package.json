{
  "name": "funds-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check:money-colors": "bash scripts/check-money-colors.sh",
    "preview": "vite preview",
    "test:e2e": "playwright test",
